STRIPE_SECRET_KEY=sk_test_DEIN_STRIPE_SECRET_KEY
# Publishable Key für pay.html / Apps (pk_test_… / pk_live_…)
# STRIPE_PUBLISHABLE_KEY=pk_test_…
# Stripe Terminal Tap to Pay — Location-ID aus Stripe Dashboard → Terminal → Locations
# STRIPE_TERMINAL_LOCATION_ID=tml_…
# STRIPE_TERMINAL_SIMULATED=1
PORT=4242

# Stripe Billing — monatliche Abo-Rechnungen per E-Mail
# STRIPE_PRICE_STARTER=price_…
# STRIPE_PRICE_BUSINESS=price_…
# STRIPE_WEBHOOK_SECRET=whsec_…  (Events: Abo + payment_intent.* + account.updated)

# Stripe Connect: in Dashboard aktivieren, dann Admin → „Stripe Connect“ pro Mandant
# (siehe docs/STRIPE-CONNECT.md)

# Leitstelle & Einstellungen schützen (PIN — auf Render setzen!)
# Ohne ADMIN_PIN sind dispatch.html und settings.html öffentlich bearbeitbar.
ADMIN_PIN=

# Optional: Persistent Disk auf Render (Starter+) — dann DATA_DIR=/var/data
# DATA_DIR=/var/data

# Öffentliche URL nach Cloud-Deploy (Checkout Redirect)
# PUBLIC_BASE_URL=https://taxiapp-api.onrender.com

# Optional: E-Mail-Benachrichtigung bei Tarif-Anfragen (Resend)
# RESEND_API_KEY=re_…
# Verifizierte Absender-Domain in Resend, z. B. "Code & Grow <noreply@luckystaxiapp.de>"
# RESEND_FROM=Code & Grow <noreply@luckystaxiapp.de>
# CONTACT_NOTIFY_EMAIL=luckypc81@gmail.com

# Optional: Google Analytics — Besucherstatistik (Mess-ID beginnt mit G-)
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Produktion: ADMIN_PIN ist Pflicht (sonst Schreib-APIs gesperrt, wenn REQUIRE_ADMIN_PIN=1)
# REQUIRE_ADMIN_PIN=1
